# ==========================================
# Git Ignore Configuration
# ==========================================

# Node & Package Managers
node_modules/
**/node_modules/
package-lock.json.bak

# Angular & Build Artifacts
.angular/
**/.angular/
dist/
**/dist/
build/
**/build/
.dist/
**/.dist/

# Large Archives (>100MB exceeds GitHub push limit)
*.zip

# Environment & Private Secrets
.env
**/.env
**/.env.local
**/.env.*.local
!.env.example

# Python Cache & Virtual Environments
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyc
venv/
**/venv/
env/
**/env/
.pytest_cache/

# OS and Editor Metadata
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
Desktop.ini
.vscode/
.idea/

# Logs & Temporary Files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
